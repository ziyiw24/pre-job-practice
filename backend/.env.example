# 上岗练 - 后端环境变量示例
# 复制本文件为 .env 后，按实际环境填写配置值

# 核心模型网关（当前可使用 mock）
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=1
MODEL_DAILY_BUDGET=20
MODEL_MAX_COST_PER_CALL=0.5
DEMO_MODE=true
TRAINING_MAX_REVISIONS=2
TRAINING_MAX_MODEL_CALLS=6
TRAINING_TASK_TIMEOUT_SECONDS=90
TRAINING_TASK_STORE=memory
REDIS_URL=redis://localhost:6379/0
TRAINING_DOCUMENT_STORE=memory
TRAINING_UPLOAD_PREFIX=training-documents/

# 旧模块可选配置（非上岗练主链路）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网搜索配置（用于 AI 出题时获取最新知识）
TAVILY_API_KEY=your_tavily_api_key
ENABLE_WEB_SEARCH=false

# DashScope（百炼 Embedding，用于知识库 RAG）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库 / 向量存储配置
CHROMA_PERSIST_DIR=./data/chroma
KB_UPLOAD_DIR=./data/uploads
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4

# 题目配图（DashScope 千问-文生图 qwen-image，可与 Embedding 共用同一个百炼 API Key，
# 若该 Key 未开通 qwen-image 权限则需单独配置 DASHSCOPE_IMAGE_API_KEY）
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5

# 腾讯云 COS（存储 AI 生成的题目配图）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-shanghai
COS_BUCKET=your_bucket-appid
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=

# 后端服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_ENVIRONMENT=development
MAX_REQUEST_BODY_BYTES=10500000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERATE=10
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_LOGIN=20
RATE_LIMIT_ANSWERS=30
PLATFORM_STORE=memory
JWT_SECRET=replace-with-at-least-32-random-bytes

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=zhiheng_health

# 生产环境请填写精确允许的前端来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:10086
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=false
MYSQL_CONNECT_ON_START=false

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 日志级别
LOG_LEVEL=INFO
